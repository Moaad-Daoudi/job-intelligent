# --- PostgreSQL (Data Warehouse) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password_postgres
POSTGRES_DB=job_intelligent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MinIO (Data Lake) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_ENDPOINT=http://minio:9000
# Noms des buckets pour le pattern médaillon
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- FastAPI / Backend ---
# Générez une clé secrète forte (ex: openssl rand -hex 32)
SECRET_KEY=votre_cle_secrete_tres_longue_et_aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://admin:password_postgres@postgres:5432/job_intelligent

# --- Autres (optionnel) ---
# Si vous utilisez des proxys pour le scraping
PROXY_URL=http://user:password@proxy_provider:port

